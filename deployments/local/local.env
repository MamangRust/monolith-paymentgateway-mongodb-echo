# Local native-run environment: Go services run on the host and connect to the
# docker-compose infra (postgres/pgbouncer, per-service Redis, Kafka) through
# host-mapped ports. APP_ENV=kubernetes makes dotenv.Viper() skip the config
# file so only exported env vars (from this file) are used.
APP_ENV=kubernetes

DB_DRIVER=mongodb
DB_HOST=localhost
DB_HOST_MIGRATE=localhost
DB_PORT=27017
DB_USERNAME=DRAGON
DB_PASSWORD=DRAGON
DB_NAME=PAYMENT_GATEWAY

DB_MAX_OPEN_CONNS=8
DB_MAX_IDLE_CONNS=1
DB_MIN_IDLE_CONNS=1
DB_CONN_MAX_LIFETIME=30m

REDIS_HOST_APIGATEWAY=localhost
REDIS_PORT_APIGATEWAY=6379
REDIS_PASSWORD_APIGATEWAY=dragon_knight
REDIS_DB_APIGATEWAY=0

REDIS_HOST_AUTH=localhost
REDIS_PORT_AUTH=6380
REDIS_PASSWORD_AUTH=dragon_knight
REDIS_DB_AUTH=0

REDIS_HOST_USER=localhost
REDIS_PORT_USER=6381
REDIS_PASSWORD_USER=dragon_knight
REDIS_DB_USER=0

REDIS_HOST_ROLE=localhost
REDIS_PORT_ROLE=6384
REDIS_PASSWORD_ROLE=dragon_knight
REDIS_DB_ROLE=0

REDIS_HOST_CARD=localhost
REDIS_PORT_CARD=6382
REDIS_PASSWORD_CARD=dragon_knight
REDIS_DB_CARD=0

REDIS_HOST_MERCHANT=localhost
REDIS_PORT_MERCHANT=6383
REDIS_PASSWORD_MERCHANT=dragon_knight
REDIS_DB_MERCHANT=0

REDIS_HOST_SALDO=localhost
REDIS_PORT_SALDO=6385
REDIS_PASSWORD_SALDO=dragon_knight
REDIS_DB_SALDO=0

REDIS_HOST_TOPUP=localhost
REDIS_PORT_TOPUP=6387
REDIS_PASSWORD_TOPUP=dragon_knight
REDIS_DB_TOPUP=0

REDIS_HOST_TRANSACTION=localhost
REDIS_PORT_TRANSACTION=6386
REDIS_PASSWORD_TRANSACTION=dragon_knight
REDIS_DB_TRANSACTION=0

REDIS_HOST_TRANSFER=localhost
REDIS_PORT_TRANSFER=6388
REDIS_PASSWORD_TRANSFER=dragon_knight
REDIS_DB_TRANSFER=0

REDIS_HOST_WITHDRAW=localhost
REDIS_PORT_WITHDRAW=6389
REDIS_PASSWORD_WITHDRAW=dragon_knight
REDIS_DB_WITHDRAW=0

DB_SEEDER=false

SECRET_KEY=yantopedia

DB_URL=mongodb://DRAGON:DRAGON@localhost:27017/PAYMENT_GATEWAY?authSource=admin
# Kafka advertises kafka:9092 for in-network (compose) clients and
# localhost:29092 for host clients (dual-listener setup in docker-compose.yml).
KAFKA_BROKERS=localhost:29092

APP_LOGGER=production

OTEL_ENDPOINT=localhost:24317
OTEL_ENABLED=false

GRPC_AUTH_ADDR=localhost:50051
GRPC_ROLE_ADDR=localhost:50052
GRPC_CARD_ADDR=localhost:50054
GRPC_MERCHANT_ADDR=localhost:50055
GRPC_USER_ADDR=localhost:50053
GRPC_SALDO_ADDR=localhost:50056
GRPC_TOPUP_ADDR=localhost:50058
GRPC_TRANSACTION_ADDR=localhost:50057
GRPC_TRANSFER_ADDR=localhost:50059
GRPC_WITHDRAW_ADDR=localhost:50060

GRPC_AUTH_PORT=50051
GRPC_ROLE_PORT=50052
GRPC_CARD_PORT=50054
GRPC_MERCHANT_PORT=50055
GRPC_USER_PORT=50053
GRPC_SALDO_PORT=50056
GRPC_TOPUP_PORT=50058
GRPC_TRANSACTION_PORT=50057
GRPC_TRANSFER_PORT=50059
GRPC_WITHDRAW_PORT=50060

